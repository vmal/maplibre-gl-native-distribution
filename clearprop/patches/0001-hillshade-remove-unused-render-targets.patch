From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ClearProp <vbvmalhotra@gmail.com>
Date: Thu, 29 Oct 2026 14:18:18 -0700
Subject: [PATCH 1/3] hillshade: remove render targets of tiles no longer
 rendered

Port of maplibre-native #4754. Each raster-dem tile keeps a hillshade render target; targets for tiles that leave the render set were never dropped, so their offscreen passes kept running every frame.
---
 .../renderer/layers/render_hillshade_layer.cpp   | 16 ++++++++++++++++
 .../renderer/layers/render_hillshade_layer.hpp   |  3 +++
 2 files changed, 19 insertions(+)

diff --git a/src/mbgl/renderer/layers/render_hillshade_layer.cpp b/src/mbgl/renderer/layers/render_hillshade_layer.cpp
index c33f41d1ed..c9d804f663 100644
--- a/src/mbgl/renderer/layers/render_hillshade_layer.cpp
+++ b/src/mbgl/renderer/layers/render_hillshade_layer.cpp
@@ -148,6 +148,17 @@ void RenderHillshadeLayer::removeRenderTargets(UniqueChangeRequestVec& changes)
     activatedRenderTargets.clear();
 }
 
+// A render target is only needed while its tile is rendered. Without this they pile up for every tile ever drawn and
+// the renderer runs a pass for each of them every frame (maplibre-native #4684).
+void RenderHillshadeLayer::removeUnusedRenderTargets(const std::unordered_set<const RenderTarget*>& inUse,
+                                                     UniqueChangeRequestVec& changes) {
+    std::erase_if(activatedRenderTargets, [&](const RenderTargetPtr& renderTarget) {
+        if (inUse.contains(renderTarget.get())) return false;
+        activateRenderTarget(renderTarget, false, changes);
+        return true;
+    });
+}
+
 static const std::string HillshadePrepareShaderGroupName = "HillshadePrepareShader";
 static const std::string HillshadeShaderGroupName = "HillshadeShader";
 
@@ -231,6 +242,8 @@ void RenderHillshadeLayer::update(gfx::ShaderRegistry& shaders,
         return hillshadePrepareVertexAttrs;
     };
 
+    std::unordered_set<const RenderTarget*> renderTargetsInUse;
+
     for (const RenderTile& tile : *renderTiles) {
         const auto& tileID = tile.getOverscaledTileID();
 
@@ -303,6 +316,7 @@ void RenderHillshadeLayer::update(gfx::ShaderRegistry& shaders,
                 ++stats.drawablesAdded;
             }
         }
+        renderTargetsInUse.insert(bucket.renderTarget.get());
 
         // Set up tile drawable
         std::shared_ptr<HillshadeVertexVector> vertices;
@@ -386,6 +400,8 @@ void RenderHillshadeLayer::update(gfx::ShaderRegistry& shaders,
             ++stats.drawablesAdded;
         }
     }
+
+    removeUnusedRenderTargets(renderTargetsInUse, changes);
 }
 
 } // namespace mbgl
diff --git a/src/mbgl/renderer/layers/render_hillshade_layer.hpp b/src/mbgl/renderer/layers/render_hillshade_layer.hpp
index 3490788bc0..ea7cdf41c0 100644
--- a/src/mbgl/renderer/layers/render_hillshade_layer.hpp
+++ b/src/mbgl/renderer/layers/render_hillshade_layer.hpp
@@ -1,5 +1,7 @@
 #pragma once
 
+#include <unordered_set>
+
 #include <mbgl/renderer/render_layer.hpp>
 #include <mbgl/renderer/buckets/hillshade_bucket.hpp>
 #include <mbgl/style/layers/hillshade_layer_impl.hpp>
@@ -44,6 +46,7 @@ private:
 
     void addRenderTarget(const RenderTargetPtr&, UniqueChangeRequestVec&);
     void removeRenderTargets(UniqueChangeRequestVec&);
+    void removeUnusedRenderTargets(const std::unordered_set<const RenderTarget*>& inUse, UniqueChangeRequestVec&);
 
     // Paint properties
     style::HillshadePaintProperties::Unevaluated unevaluated;
